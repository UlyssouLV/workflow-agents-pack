{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "sh .cursor/hooks/gate-code-review.sh",
        "matcher": "Task|Skill|Agent",
        "failClosed": true
      },
      {
        "command": "sh .cursor/hooks/bloque-up-ecarts-pack.sh",
        "matcher": "Skill",
        "failClosed": false
      }
    ],
    "subagentStart": [
      {
        "command": "sh .cursor/hooks/gate-code-review.sh",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "sh .cursor/hooks/bloque-up-ecarts-pack.sh",
        "failClosed": false
      }
    ]
  }
}
